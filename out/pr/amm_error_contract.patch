-find "$LOG_DIR" -type f -delete 2>/dev/null || true
+
+clean_dir() {
+  local dir="$1"
+  if [[ -d "$dir" ]]; then
+    find "$dir" -type f ! -name '.gitkeep' -delete 2>/dev/null || true
+  fi
+}
+
+clean_dir "$LOG_DIR"
+clean_dir "$PKG_DIR"
+clean_dir "$PR_DIR"
+clean_dir "$JIRA_DIR"
 
