++-++            !message.trim().is_empty(),
++-++            "user message must be non-empty for {}",
++-++            variant.variant_name()
++-++        );
++-++        assert!(
++-++            message.ends_with('.'),
++-++            "user message must end with period: {message}"
++-++        );
